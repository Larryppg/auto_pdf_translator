# DeepSeek uses an OpenAI-compatible API. The variable name is retained so
# existing installations do not need to migrate their stored key.
OPENAI_API_KEY=replace-with-your-own-deepseek-api-key

# Optional overrides for the default DeepSeek configuration.
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-v4-flash
